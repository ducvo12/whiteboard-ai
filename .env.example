# All settings are optional. Uncomment only the settings you want to override
# in .env.local. The editor works without configuring chat.

# Absolute path or executable name of a compatible Codex CLI.
# Otherwise the app checks the macOS ChatGPT bundle, then codex on PATH.
# CODEX_BIN=codex

# Model identifier available to your Codex account. Omit to use its default.
# CODEX_MODEL=your-model-id

# Existing Codex login directory containing auth.json. Defaults to ~/.codex.
# CODEX_HOME=/absolute/path/to/.codex

# Writable board file. Relative paths are resolved from the project directory.
# WHITEBOARD_DATA_PATH=.data/whiteboard.json

# Supply an appropriate tldraw license key for your intended use.
# NEXT_PUBLIC_TLDRAW_LICENSE_KEY=your-license-key
